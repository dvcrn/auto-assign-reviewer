{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-assign-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    // GitHub App "assignicorn"
    "APP_ID": "5657291",
    // Login requested as reviewer on every newly opened pull request
    "REVIEWER": "dvcrn",
    // Repository prefixes ("owner/") or full names ("owner/repo") eligible for review assignment
    "ALLOWED_REPOS": ["dvcrn/", "digitalvibeshq/", "microfnhq/"]
  },
  // Secrets (set with `mise run secrets:push`): GITHUB_WEBHOOK_SECRET, GITHUB_APP_PRIVATE_KEY (PKCS#8 PEM)
  "observability": {
    "logs": {
      "enabled": true,
      "destinations": ["new-relic-logs", "axiom-logs"],
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
